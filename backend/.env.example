# Neon PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
# Optional: separate test database URL for integration tests
TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname_test

# App settings
# DEV ONLY: unauthenticated session token generation requires ENVIRONMENT=development on localhost
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_ECHO=false
# Optional development trace viewer: set the same random 32+ character value in web/.env.local.
# TRACE_ACCESS_SECRET=

# LiveKit Cloud Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Agent Dispatch Name (Must match between FastAPI token route and Worker)
LIVEKIT_AGENT_NAME=voxora-agent
# Optional override (takes precedence if non-empty):
# LIVEKIT_AGENT_NAME_OVERRIDE=

# Voice Provider Keys (Phase 1 Worker)
GOOGLE_API_KEY=your-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id

# Optional Voice Model Overrides (Phase 1 defaults shown)
# DEEPGRAM_STT_MODEL=flux-general-en
# GOOGLE_LLM_MODEL=gemini-3.1-flash-lite
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Generate a unique random secret (at least 32 bytes) for owner JWTs.
OWNER_JWT_SECRET=

# Optional Google Calendar sync (see docs/google-calendar.md).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/owner/google-calendar/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_ENCRYPTION_KEY=
