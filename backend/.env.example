# Neon PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
# Optional: separate test database URL for integration tests
TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname_test

# Voice providers (Phase 1)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# JWT / Cookie secrets (Phase 7)
JWT_SECRET=changeme
COOKIE_SECRET=changeme

# App settings
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
DB_ECHO=false

